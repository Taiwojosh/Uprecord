# Production Environment Configuration
# Copy to .env in your deployed environment

# SQLite pilot: mount persistent storage here and back it up. See docs/phase2a-deployment.md.
# PostgreSQL is NOT compatible with the current SQLite Prisma schema/migrations.
DATABASE_URL="file:/var/lib/globepen/globepen.db"

# Server Configuration
SERVER_PORT=3001
NODE_ENV=production
CLIENT_URL="https://app.your-owned-domain.example"
PLATFORM_HOSTS="app.your-owned-domain.example"
PLATFORM_BASE_DOMAINS="your-owned-domain.example"
# Use only your actual proxy IP/CIDR. Never trust arbitrary forwarded headers.
TRUSTED_PROXIES=false

# JWT & Authentication (Generate using: openssl rand -base64 32)
JWT_SECRET="CHANGE_TO_A_CRYPTOGRAPHICALLY_SECURE_RANDOM_SECRET_IN_PRODUCTION"
JWT_EXPIRES_IN="7d"

# Server-Side Gemini API Key (Kept strictly on the backend — never in client bundles)
GEMINI_API_KEY=""

# Initial Platform Superadmin Seed (Only used by prisma/seed.ts or seedSuperadmin.ts)
INITIAL_SUPERADMIN_EMAIL="superadmin@your-owned-domain.example"
INITIAL_SUPERADMIN_PASSWORD="CHANGE_TO_A_STRONG_UNIQUE_PASSWORD"
