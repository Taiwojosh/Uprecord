# ─── Frontend (Vite) ──────────────────────────────────────────────────
# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# License Server
VITE_LICENSE_API_URL=https://rcpro-license-server.rcpro-license.workers.dev
VITE_LICENSE_PORTAL_URL=https://rcpro-license-server.rcpro-license.workers.dev/api/portal
VITE_GOOGLE_SHEET_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# NOTE: No API keys (like GEMINI_API_KEY) are ever exposed in frontend client bundles!

# ─── Backend Server ──────────────────────────────────────────────────
# Database (SQLite for local dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/uprecord?schema=public"

# Server port (Vite runs on 3000, server on 3001)
SERVER_PORT=3001
CLIENT_URL=http://localhost:3000
NODE_ENV=development

# Authentication — CHANGE THESE IN PRODUCTION
JWT_SECRET=change-me-to-a-real-random-secret-in-production
JWT_EXPIRES_IN=7d

# Initial database-backed superadmin seed (only used by seed script)
INITIAL_SUPERADMIN_EMAIL=superadmin@uprecord.local
INITIAL_SUPERADMIN_PASSWORD=change-me-to-a-strong-password

# Server-Side Gemini API Key (Kept strictly on the backend — never in client bundles)
GEMINI_API_KEY=""

# Payment Integration
PAYSTACK_SECRET_KEY=
